{
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/__tests__/*",
        "lib",
        "types"
    ],
    "compilerOptions": {
        "lib": [
            "ESNext",
            "DOM",
            "dom.iterable"
        ],
        "skipLibCheck": true,
        "moduleResolution": "Node",
        "removeComments": true,
        "outDir": "./lib",
        "declaration": true,
        "noEmitOnError": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "sourceMap": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowJs": false,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "esModuleInterop": true,
        "module": "ESNext",
        "target": "ESNext"
    }
}
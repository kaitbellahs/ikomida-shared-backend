{
  "name": "@ikomida/shared-backend",
  "version": "1.6.11",
  "description": "the iKomida backend shared code",
  "private": false,
  "main": "lib/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib/",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "node": ">=16",
  "scripts": {
    "build": "rimraf ./types ./lib ./docs && rollup -c",
    "prebuild:types": "rimraf ./types",
    "build:types": "tsc -p ./tsconfig.json --outDir types && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./types ./lib ./docs",
    "glogin": "artifactregistry-auth",
    "local": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn build",
    "test": "jest -c jest.tsc.config.js"
  },
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "peerDependencies": {
    "@ikomida/shared-logics": "*",
    "@ikomida/shared-types": "*"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "axios": "^1.2.2",
    "bcrypt": "^5.1.0",
    "firebase-admin": "^11.4.1",
    "jose": "^4.11.2",
    "luxon": "^3.2.0",
    "mysql2": "^2.3.3",
    "node-mailjet": "^6.0.0",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.28.0",
    "sequelize-typescript": "^2.1.5",
    "sharp": "^0.31.3",
    "uuid": "^9.0.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@firebase/app-types": "0.x",
    "@ikomida/shared-logics": "^1.3.1",
    "@ikomida/shared-types": "^1.9.7",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^10.0.1",
    "@types/amqplib": "^0.10.1",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^18.11.18",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^9.0.0",
    "@types/validator": "^13.7.10",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.3.1",
    "jest-runner-tsc": "^1.6.0",
    "prettier": "^2.8.1",
    "rimraf": "^3.0.2",
    "rollup": "^3.9.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.0.3",
    "typescript": "^4.9.4"
  }
}
{
  "name": "@ikomida/shared-backend",
  "version": "0.0.233",
  "description": "the iKomida backend shared code",
  "private": false,
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "README.md",
    "package.json"
  ],
  "exports": {
    "import": "./lib/index.mjs",
    "require": "./lib/index.cjs"
  },
  "type": "module",
  "node": ">=14.13.1",
  "scripts": {
    "build": "rimraf ./build ./lib ./docs && tsc && rollup -c",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./lib ./docs",
    "glogin": "artifactregistry-auth",
    "prepare": "yarn build",
    "prepublishOnly": "yarn lint",
    "preversion": "yarn lint",
    "version": "yarn format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "mocha"
  },
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "dependencies": {
    "@ikomida/shared-logics": "^0.0.41",
    "@ikomida/shared-types": "^0.0.142",
    "amqplib": "^0.10.3",
    "axios": "^0.27.2",
    "bcrypt": "^5.0.1",
    "firebase-admin": "^11.0.1",
    "https": "^1.0.0",
    "jose": "^4.9.3",
    "jsonwebtoken": "^8.5.1",
    "luxon": "^3.0.4",
    "mariadb": "^3.0.1",
    "mysql2": "^2.3.3",
    "node-mailjet": "^5.1.1",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.23.1",
    "sequelize-typescript": "^2.1.3",
    "sharp": "^0.31.0",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@firebase/app-types": "^0.7.0",
    "@microsoft/api-extractor": "^7.31.2",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/amqplib": "^0.8.2",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.14",
    "@types/linkify-it": "^3.0.2",
    "@types/luxon": "^3.0.1",
    "@types/node": "^18.7.21",
    "@types/node-mailjet": "^3.3.9",
    "@types/sharp": "^0.31.0",
    "@types/validator": "^13.7.7",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "chai": "^4.3.6",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "express": "^4.18.1",
    "google-artifactregistry-auth": "^3.0.2",
    "jsdoc": "^3.6.11",
    "linkify-it": "^4.0.1",
    "mocha": "^10.0.0",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "ts-node": "^10.9.1",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.15",
    "typescript": "^4.8.3"
  }
}